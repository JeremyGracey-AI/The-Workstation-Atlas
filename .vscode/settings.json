{
    "claudeCode.useTerminal": true,

    // Point Cursor at the project-local venv rather than ~/.venv, so opening a
    // notebook picks the right interpreter without a manual kernel selection.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,

    // Notebooks live here; keep the kernel sticky and don't nag on every open.
    "jupyter.kernels.excludePythonEnvironments": [],
    "notebook.output.textLineLimit": 60,
    "notebook.output.scrolling": true,

    // Outputs are scrubbed by the nbstripout clean filter on the way into git
    // (see .gitattributes), so committed diffs stay readable.
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true
}
